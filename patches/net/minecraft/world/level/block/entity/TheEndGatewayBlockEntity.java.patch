+    private void stepAsyncExitResolution(ServerLevel level, BlockPos gatewayPos) {
+        if (this.isRemoved() || this.exitPortal != null || level.dimension() != Level.END) {
+            this.clearAsyncProbeTicket(level, gatewayPos);
+            this.asyncPhase = 0;
+            this.asyncExitResolving = false;
+            return;
+        }
+
+        Vec3 dir = new Vec3((double)gatewayPos.getX(), 0.0, (double)gatewayPos.getZ()).normalize();
+        if (this.asyncPhase == 0) {
+            this.asyncProbePos = dir.scale(1024.0);
+            this.asyncStepsRemaining = 16;
+            this.asyncPhase = 1;
+        }
+
+        while (true) {
+            if (this.asyncPhase == 1) {
+                ChunkPos probeChunk = new ChunkPos(Mth.floor(this.asyncProbePos.x / 16.0), Mth.floor(this.asyncProbePos.z / 16.0));
+                LevelChunk chunk = level.getChunkSource().getChunkNow(probeChunk.x, probeChunk.z);
+                if (chunk == null) {
+                    this.ensureAsyncProbeTicket(level, gatewayPos, probeChunk, 0);
+                    return;
+                }
+                if (chunk.getHighestFilledSectionIndex() != -1 && this.asyncStepsRemaining-- > 0) {
+                    LOGGER.debug("Skipping backwards past nonempty chunk at {}", this.asyncProbePos);
+                    this.asyncProbePos = this.asyncProbePos.add(dir.scale(-16.0));
+                    continue;
+                }
+                this.asyncStepsRemaining = 16;
+                this.asyncPhase = 2;
+            }
+
+            if (this.asyncPhase == 2) {
+                ChunkPos probeChunk = new ChunkPos(Mth.floor(this.asyncProbePos.x / 16.0), Mth.floor(this.asyncProbePos.z / 16.0));
+                LevelChunk chunk = level.getChunkSource().getChunkNow(probeChunk.x, probeChunk.z);
+                if (chunk == null) {
+                    this.ensureAsyncProbeTicket(level, gatewayPos, probeChunk, 0);
+                    return;
+                }
+                if (chunk.getHighestFilledSectionIndex() == -1 && this.asyncStepsRemaining-- > 0) {
+                    LOGGER.debug("Skipping forward past empty chunk at {}", this.asyncProbePos);
+                    this.asyncProbePos = this.asyncProbePos.add(dir.scale(16.0));
+                    continue;
+                }
+                LOGGER.debug("Found chunk at {}", this.asyncProbePos);
+                this.asyncPhase = 3;
+            }
+
+            if (this.asyncPhase == 3) {
+                ChunkPos targetChunk = new ChunkPos(Mth.floor(this.asyncProbePos.x / 16.0), Mth.floor(this.asyncProbePos.z / 16.0));
+                for (int dx = -1; dx <= 1; dx++) {
+                    for (int dz = -1; dz <= 1; dz++) {
+                        if (level.getChunkSource().getChunkNow(targetChunk.x + dx, targetChunk.z + dz) == null) {
+                            this.ensureAsyncProbeTicket(level, gatewayPos, targetChunk, 1);
+                            return;
+                        }
+                    }
+                }
+
+                LevelChunk levelchunk = level.getChunkSource().getChunkNow(targetChunk.x, targetChunk.z);
+                BlockPos blockpos = findValidSpawnInChunk(levelchunk);
+                if (blockpos == null) {
+                    BlockPos blockpos1 = BlockPos.containing(this.asyncProbePos.x + 0.5, 75.0, this.asyncProbePos.z + 0.5);
+                    LOGGER.debug("Failed to find a suitable block to teleport to, spawning an island on {}", blockpos1);
+                    level.registryAccess()
+                        .registry(Registries.CONFIGURED_FEATURE)
+                        .flatMap(p_258975_ -> p_258975_.getHolder(EndFeatures.END_ISLAND))
+                        .ifPresent(
+                            p_256040_ -> p_256040_.value()
+                                .place(level, level.getChunkSource().getGenerator(), RandomSource.create(blockpos1.asLong()), blockpos1)
+                        );
+                    blockpos = blockpos1;
+                } else {
+                    LOGGER.debug("Found suitable block to teleport to: {}", blockpos);
+                }
+
+                BlockPos exit = findTallestBlock(level, blockpos, 16, true).above(GATEWAY_HEIGHT_ABOVE_SURFACE);
+                LOGGER.debug("Creating portal at {}", exit);
+                spawnGatewayPortal(level, exit, EndGatewayConfiguration.knownExit(gatewayPos, false));
+                this.setExitPosition(exit, this.exactTeleport);
+                this.clearAsyncProbeTicket(level, gatewayPos);
+                this.asyncPhase = 0;
+                this.asyncExitResolving = false;
+                return;
+            }
+
+            return;
+        }
+    }
