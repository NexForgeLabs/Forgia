+    private void ensureAsyncProbeTicket(ServerLevel level, BlockPos gatewayPos, ChunkPos chunkPos, int radius) {
+        if (chunkPos.equals(this.asyncProbeChunk) && this.asyncProbeTicketRadius == radius) {
+            if (++this.asyncTicketTicks < 200) {
+                return;
+            }
+            this.asyncTicketTicks = 0;
+            level.getChunkSource().addRegionTicket(TicketType.PORTAL, chunkPos, radius, gatewayPos);
+            return;
+        }
+        this.clearAsyncProbeTicket(level, gatewayPos);
+        level.getChunkSource().addRegionTicket(TicketType.PORTAL, chunkPos, radius, gatewayPos);
+        this.asyncProbeChunk = chunkPos;
+        this.asyncProbeTicketRadius = radius;
+        this.asyncTicketTicks = 0;
+    }
+
+    private void clearAsyncProbeTicket(ServerLevel level, BlockPos gatewayPos) {
+        if (this.asyncProbeChunk != null && this.asyncProbeTicketRadius >= 0) {
+            level.getChunkSource().removeRegionTicket(TicketType.PORTAL, this.asyncProbeChunk, this.asyncProbeTicketRadius, gatewayPos);
+            this.asyncProbeChunk = null;
+            this.asyncProbeTicketRadius = -1;
+            this.asyncTicketTicks = 0;
+        }
+    }
