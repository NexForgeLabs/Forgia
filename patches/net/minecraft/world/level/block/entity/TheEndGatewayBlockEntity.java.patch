+    private void scheduleAsyncExitStep(ServerLevel level, BlockPos gatewayPos) {
+        if (level.getServer().isSameThread() && !net.neoforged.neoforge.server.threading.RegionThreadingHooks.isNativeRegionWorkerThread()) {
+            this.stepAsyncExitResolution(level, gatewayPos);
+            return;
+        }
+        if (this.asyncStepQueued) {
+            return;
+        }
+        this.asyncStepQueued = true;
+        level.getServer().execute(() -> {
+            this.asyncStepQueued = false;
+            if (!this.isRemoved() && this.exitPortal == null) {
+                this.stepAsyncExitResolution(level, gatewayPos);
+            }
+        });
+    }
